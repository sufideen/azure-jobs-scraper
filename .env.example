# Azure Jobs Scraper — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it is in .gitignore.

# Gmail account address (sender)
GMAIL_USER=your.gmail.address@gmail.com

# Gmail App Password (16 characters, NOT your Gmail login password)
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email recipient — jobs report will be sent here
RECIPIENT_EMAIL=you@example.com

# Anthropic API key — optional. When set, the scraper calls Claude to
# generate a tailored CV-tweak summary + cover letter draft for each
# "Strong" CV-match job (see utils/match.py), saved as .md files.
# Get one at: https://console.anthropic.com/settings/keys
# Leave blank to skip this feature entirely — everything else still works.
ANTHROPIC_API_KEY=
